#!/usr/bin/env bash
# siyuan — 思源笔记 shell 风格命令行 (基于 SiYuan-Kernel 3.8+)
#
# 像 Linux 命令一样操作思源笔记: ls/cat/head/tail/find/grep/which/stat/tree/sql ...
# 命令可组合 (管道 / 统一行式输出 / --json 稳定字段 / --markdown 笔记可直接用)。
# 退出码: 0=成功 1=业务错误 2=用法错误 3=配置错误 124=超时
# 底层命令全集: siyuan raw --help; 环境变量: SIYUAN_KERNEL/SIYUAN_WORKSPACE/SIUAN_FORMAT/SIYUAN_TIMEOUT

set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ---------------------------------------------------------------------------
# 配置检查 (框架层)
# ---------------------------------------------------------------------------
source "$BIN_DIR/lib/framework.sh"

if [[ ! -x "$SIYUAN_KERNEL" ]]; then
  echo "siyuan: 找不到内核二进制 '$SIYUAN_KERNEL'" >&2
  echo "  建议: 设置 SIYUAN_KERNEL 环境变量指向 SiYuan-Kernel 路径" >&2
  exit 3
fi
if [[ ! -d "$SIYUAN_WORKSPACE" ]]; then
  echo "siyuan: 工作区不存在 '$SIYUAN_WORKSPACE'" >&2
  echo "  建议: 设置 SIYUAN_WORKSPACE 环境变量指向思源工作区" >&2
  exit 3
fi

# ---------------------------------------------------------------------------
# 命令注册 (命令名 -> 处理函数; 别名共享处理函数)
# ---------------------------------------------------------------------------
source "$BIN_DIR/lib/cmd-query.sh"
source "$BIN_DIR/lib/cmd-misc.sh"
source "$BIN_DIR/lib/cmd-write.sh"
source "$BIN_DIR/lib/cmd-av.sh"

sy_register ls              cmd_ls            list notebooks nb
sy_register tree            cmd_tree          outline
sy_register cat             cmd_cat           read
sy_register head            cmd_head
sy_register tail            cmd_tail
sy_register find            cmd_find          search
sy_register grep            cmd_grep
sy_register which           cmd_which
sy_register stat            cmd_stat          get
sy_register sql             cmd_sql
sy_register children        cmd_children
sy_register backlinks       cmd_backlinks     bl
sy_register write           cmd_write         create
sy_register append          cmd_append
sy_register insert-block    cmd_insert_block
sy_register update-block    cmd_update_block
sy_register delete-block    cmd_delete_block
sy_register replace-doc     cmd_replace_doc
sy_register move            cmd_move
sy_register remove          cmd_remove        rm
sy_register av               cmd_av
sy_register raw             cmd_raw
sy_register raw-help        cmd_raw_help
sy_register help            cmd_help

# ---------------------------------------------------------------------------
# 帮助
# ---------------------------------------------------------------------------
usage() {
  cat <<'EOF'
siyuan — 思源笔记命令行 (基于 SiYuan-Kernel 3.8+, shell 风格)

用法: siyuan <命令> [参数...]

输出模式 (全部命令三选一, --json 与 --markdown 互斥):
  默认       人类可读文本 (行式, 可管道组合)
  --json     稳定字段 JSON (agent 用)
  --markdown markdown 输出 (表格/列表/确认块; stdout 只含 markdown, 可直接
             重定向到 .md 或粘贴进思源), 错误仍走 stderr
  例: siyuan ls --markdown > 目录.md ; siyuan sql "SELECT ..." --markdown

查询 (输出行式可管道组合, --json/--markdown 出结构化/笔记格式):
  ls [笔记本] [路径] [-l] [--json|--markdown]    列笔记本/文档 (笔记本支持 id 或中文名)
  tree <doc> [-l] [--json|--markdown]            标题树/大纲
  cat <doc> [--json|--markdown]                  读文档 markdown (最准; markdown=原样)
  head/tail <doc> [-n N] [--json|--markdown]     读文档开头/末尾 N 行 (默认 10)
  find <关键词> [--notebook <nb>] [--json|--markdown]  跨库搜文档标题
  grep <pattern> [-v] [-i] [-l] [-m 0-3] [--notebook <nb>] [--json|--markdown]
                                      内容全文检索; 管道输入时按行过滤 (真 grep)
  which <doc-id|标题|/路径> [-v] [--json|--markdown]  定位文档 → 输出 doc id
  stat <doc> [--json|--markdown]                 文档元信息
  sql "<语句>" [-l N] [-H] [--json|--markdown]   SQL 查询

块查询:
  children <block-id> [--json|--markdown]        子块列表 (编辑前定位)
  backlinks <block-id> [--keyword <kw>] [--json|--markdown]  反链

写入/编辑 (--markdown 返回确认块: 文档 id+标题+链接; --json 出稳定字段):
  write --notebook <nb> --title <t> [--parent-id <pid>|--path <hpath>] [--file|stdin]
                                      建文档 (推荐 --parent-id), 返回新文档 id
  append <doc-id> [--data|--file|stdin]   追加到文档末尾
  insert-block --previous <bid>|--parent <doc-id> [--data|--file|stdin]  插入块
  update-block <block-id> [--data|--file]  替换块内容
  replace-doc <doc-id> [--data|--file|stdin]  替换整篇文档 (删旧写新, 保留标题)
  delete-block <block-id>              删除块
  move <doc-id> --parent-id <pid>      移动文档
  remove <doc-id>                      删除文档

数据库 (属性视图, 适配 3.8.0):
  av list [--json|--markdown]         列出全部数据库 (名称+avID)
  av keys <avID> [--json|--markdown]  列字段
  av rows <avID> [--limit N] [-H] [--json|--markdown]  列行数据 (走 render)
  av get <avID> --row <rowID> [--json|--markdown]  单行详情
  av add <avID> --values '<JSON>' [--content <标题>] [--block <doc-id>] [--json|--markdown]  加行
  av update <avID> --row <rowID> --values '<JSON>' [--json|--markdown]  改行 (写后验证)
  av remove <avID> --row <rowID> [--json|--markdown]  删行
  av verify <avID> [--json|--markdown] 逐行打印实际值 (验证权威入口)
  av export <avID>                   导出全量 JSON (备份)

底层:
  raw <args...>                        透传 SiYuan-Kernel (自带 -w, 默认 table; --markdown 原样无转换)
  raw-help <sub...>                    查底层命令帮助 (例: raw-help block insert)

其他:
  help [命令]                          帮助; notebooks/list/read/get/outline/search 为旧名别名

文档引用 <doc>: doc-id | 标题 | /完整路径 (用 which 定位, 多匹配报错并列出候选)
环境变量: SIYUAN_KERNEL / SIYUAN_WORKSPACE / SIYUAN_FORMAT(text|json) /
          SIYUAN_TIMEOUT(默认60) / SIYUAN_DEFAULT_NOTEBOOK / SIYUAN_API_HOST / SIYUAN_API_PORT
EOF
}

# 单命令帮助
sy_usage() {
  case "$1" in
    ls)       cat <<'EOF'
用法: siyuan ls [笔记本] [路径] [-l] [--json|--markdown]
  无参: 列笔记本 (设 SIYUAN_DEFAULT_NOTEBOOK 时列该库根目录文档)
  ls 工作          列笔记本「工作」根目录文档
  ls 工作 /供应链   列 /供应链 下的文档 (支持 hpath 或 internal path)
  -l  详情 (子文档数/大小/修改时间); --json 稳定字段 {id,name,path,size,subFileCount,mtime};
      --markdown 表格 (名称/ID/笔记本), 如 siyuan ls --markdown > 目录.md
EOF
;;
    tree)     cat <<'EOF'
用法: siyuan tree <doc> [-l] [--json|--markdown]
  标题树/大纲 (对应 outline get); 文本按标题层级缩进, -l 附块 id;
  --markdown 嵌套无序列表
EOF
;;
    cat)      cat <<'EOF'
用法: siyuan cat <doc> [--json|--markdown]
  读文档 markdown (export md, 最准); 文本=纯 markdown 可直接管道消费;
  --markdown 与原样相同 (本就是 md)
EOF
;;
    head|tail) cat <<'EOF'
用法: siyuan head|tail <doc> [-n N] [--json|--markdown]
  读文档开头/末尾 N 行 (默认 10; 内部 cat 截断, 不新增内核调用);
  --markdown 用 fenced code block 标记片段
EOF
;;
    find)     cat <<'EOF'
用法: siyuan find <关键词> [--notebook <nb>] [-l N] [--json|--markdown]
  跨库搜文档标题 (document search); 与 grep 区分: find 找文档, grep 找内容
  输出: doc_id<TAB>hPath<TAB>notebook_id; --markdown 链接式列表
EOF
;;
    grep)     cat <<'EOF'
用法: siyuan grep <pattern> [-v] [-i] [-l] [-m 0-3] [--notebook <nb>] [-s N] [--json|--markdown]
  双模式:
    stdin 非终端: 按行过滤上游输出 (真 grep), 如 siyuan ls 工作 | siyuan grep 调课
    stdin 终端:   内容全文检索 (kernel search; -m 0=关键词 1=query-syntax 2=sql 3=regex)
  内容模式输出: doc_id<TAB>hPath<TAB>内容; -l 只列 doc_id; 无匹配退出 1;
  --markdown 按文档分组列表 (文档链接 + 内容片段)
EOF
;;
    which)    cat <<'EOF'
用法: siyuan which <doc-id|标题|/路径> [-v] [--json|--markdown]
  定位文档 → 输出唯一 doc id (可组合: cat $(siyuan which 标题))
  -v 附 hPath/notebook; 多匹配列出候选并退出 1 (用 /完整路径 消歧);
  --markdown 键值列表 (文档 ID/路径/笔记本)
EOF
;;
    stat)     cat <<'EOF'
用法: siyuan stat <doc> [--json|--markdown]
  文档元信息 (document get); 文本 key: value, --json 原始对象, --markdown 键值表
EOF
;;
    sql)      cat <<'EOF'
用法: siyuan sql "<语句>" [-l N] [-H] [--json|--markdown]
  SQL 查询 (透传内核, 默认 limit 100); 文本=TSV 行 (无表头可组合, -H 加表头);
  --markdown 表格 (含表头分隔行), 如 siyuan sql "SELECT id,hpath FROM blocks LIMIT 5" --markdown
EOF
;;
    children|backlinks|write|append|insert-block|update-block|delete-block|replace-doc|move|remove|av|raw|raw-help)
      if [[ -n "${1:-}" && "$1" == av* ]]; then
        av_usage "${1#av }"
      else
        usage >&2
      fi
      ;;
    *) usage >&2;;
  esac
}

# ---------------------------------------------------------------------------
# 主入口
# ---------------------------------------------------------------------------
cmd_help() {
  if [[ -n "${1:-}" ]]; then
    sy_usage "$1"
  else
    usage
  fi
}

main() {
  if [[ $# -eq 0 ]]; then
    usage
    return 0
  fi
  local cmd="$1"; shift
  case "$cmd" in
    -h|--help|help) cmd_help "$@"; return 0;;
  esac
  SY_CMD_NAME="$cmd"
  local rc=0
  sy_dispatch "$cmd" "$@" || rc=$?
  if [[ $rc -eq 255 ]]; then
    echo "siyuan: 未知命令: $cmd" >&2
    echo "  建议: 运行 'siyuan help' 查看用法, 或 'siyuan raw --help' 看底层命令全集" >&2
    return 2
  fi
  return "$rc"
}
main "$@"
