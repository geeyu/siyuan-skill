#!/usr/bin/env bash
# siyuan — 思源笔记 shell 风格命令行 (基于 SiYuan-Kernel 3.8+)
#
# 像 Linux 命令一样操作思源笔记: ls/cat/head/tail/find/grep/which/stat/tree/sql ...
# 命令可组合 (管道 / 统一行式输出 / --json 稳定字段 / --markdown 笔记可直接用)。
# 退出码: 0=成功 1=业务错误 2=用法错误 3=配置错误 124=超时
# 底层命令全集: siyuan raw --help; 环境变量: SIYUAN_KERNEL/SIYUAN_WORKSPACE/SIUAN_FORMAT/SIYUAN_TIMEOUT

set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ---------------------------------------------------------------------------
# 配置检查 (框架层)
# ---------------------------------------------------------------------------
source "$BIN_DIR/lib/framework.sh"

if [[ ! -x "$SIYUAN_KERNEL" ]]; then
  echo "siyuan: 找不到内核二进制 '$SIYUAN_KERNEL'" >&2
  echo "  建议: 设置 SIYUAN_KERNEL 环境变量指向 SiYuan-Kernel 路径" >&2
  exit 3
fi
if [[ ! -d "$SIYUAN_WORKSPACE" ]]; then
  echo "siyuan: 工作区不存在 '$SIYUAN_WORKSPACE'" >&2
  echo "  建议: 设置 SIYUAN_WORKSPACE 环境变量指向思源工作区" >&2
  exit 3
fi

# ---------------------------------------------------------------------------
# 命令注册 (命令名 -> 处理函数; 别名共享处理函数)
# ---------------------------------------------------------------------------
source "$BIN_DIR/lib/cmd-query.sh"
source "$BIN_DIR/lib/cmd-misc.sh"
source "$BIN_DIR/lib/cmd-write.sh"
source "$BIN_DIR/lib/cmd-edit.sh"
source "$BIN_DIR/lib/cmd-av.sh"

sy_register ls              cmd_ls            list notebooks nb
sy_register tree            cmd_tree          outline
sy_register cat             cmd_cat           read
sy_register head            cmd_head
sy_register tail            cmd_tail
sy_register find            cmd_find          search
sy_register grep            cmd_grep
sy_register which           cmd_which
sy_register stat            cmd_stat          get
sy_register sql             cmd_sql
sy_register children        cmd_children
sy_register backlinks       cmd_backlinks     bl
sy_register write           cmd_write         create
sy_register append          cmd_append
sy_register insert-block    cmd_insert_block
sy_register update-block    cmd_update_block
sy_register delete-block    cmd_delete_block
sy_register replace-doc     cmd_replace_doc
sy_register move            cmd_move
sy_register remove          cmd_remove
sy_register touch           cmd_touch
sy_register edit            cmd_edit
sy_register mv              cmd_mv
sy_register cp              cmd_cp
sy_register rm              cmd_rm
sy_register diff            cmd_diff
sy_register rename          cmd_rename
sy_register db               cmd_av av
sy_register raw             cmd_raw
sy_register raw-help        cmd_raw_help
sy_register help            cmd_help

# ---------------------------------------------------------------------------
# 帮助
# ---------------------------------------------------------------------------
usage() {
  cat <<'EOF'
siyuan — 思源笔记命令行 (基于 SiYuan-Kernel 3.8+, shell 风格)

用法: siyuan <命令> [参数...]

输出模式 (全部命令三选一, --json 与 --markdown 互斥):
  默认       人类可读文本 (行式, 可管道组合)
  --json     稳定字段 JSON (agent 用)
  --markdown markdown 输出 (表格/列表/确认块; stdout 只含 markdown, 可直接
             重定向到 .md 或粘贴进思源), 错误仍走 stderr
  例: siyuan ls --markdown > 目录.md ; siyuan sql "SELECT ..." --markdown

查询 (输出行式可管道组合, --json/--markdown 出结构化/笔记格式):
  ls [引用] [-l] [--json|--markdown]            列笔记本/文档 (引用=笔记本名|id|路径, 通配 /*/xxx)
  tree <doc> [-l] [--json|--markdown]            标题树/大纲
  cat <doc> [--json|--markdown]                  读文档 markdown (最准; markdown=原样)
  head/tail <doc> [-n N] [--json|--markdown]     读文档开头/末尾 N 行 (默认 10)
  find <关键词> [--notebook <nb>] [--json|--markdown]  跨库搜文档标题
  grep <pattern> [-v] [-i] [-l] [-m 0-3] [--notebook <nb>] [--json|--markdown]
                                      内容全文检索; 管道输入时按行过滤 (真 grep)
  which <doc-id|标题|/路径> [-v] [--json|--markdown]  定位文档 → 输出 doc id
  stat <doc> [--json|--markdown]                 文档元信息
  sql "<语句>" [-l N] [-H] [--json|--markdown]   SQL 查询

块查询 (引用可为块 id 或文档引用, 文档自动定位到其根块):
  children <block|doc> [--json|--markdown]       子块列表 (编辑前定位)
  backlinks <block|doc> [--keyword <kw>] [--json|--markdown]  反链

写入/编辑 (shell 风格, 每次写操作返回目标 id; --markdown 返回确认块: 文档 id+标题+链接; --json 出稳定字段):
  touch --notebook <nb> --title <t> [--parent <pid>|--path <hpath>] [--data <md>|--file|stdin]
                                      建文档 (默认笔记本根; createDocWithMd 三步语义, 无中间块残留)
  edit <doc> (--append|--prepend|--update <block-id>|--replace) <text> [--file|stdin]
                                      统一编辑入口: 追加/开头插入/改块/整篇替换
  mv <doc> --parent <父文档> [--notebook <nb>]  移动文档 (同/跨笔记本; 别名 --to, 输出文档 id)
  cp <doc> [--parent <父文档>]         复制文档 (duplicate; 别名 --to, 输出新副本 id)
  rm <doc>                            删除文档 (接受 id/标题/路径引用, 输出文档 id)
  diff <docA> <docB> [diff 参数...]    对比两文档 markdown (统一 diff 格式; 退出码 0=同 1=异)
  rename <doc> <新标题>                重命名 (IAL title + H1 同步, 输出文档 id)

底层写入 (引用统一支持 id/标题/路径; 每次写操作返回目标 id):
  write --notebook <nb> --title <t> [--parent <父文档>|--path <hpath>] [--data <md>|--file|stdin]
                                      建文档 (同 touch, 推荐 touch), 返回新文档 id
  append <doc> [--data|--file|stdin]  追加到文档末尾 (同 edit --append)
  insert-block [--previous <块>|--parent <块|doc>] [--data|--file|stdin]  插入块
  update-block <block-id> [--data|--file]  替换块内容 (同 edit --update)
  replace-doc <doc> [--data|--file|stdin]  替换整篇文档 (删旧写新, 保留标题)
  delete-block <block-id>              删除块
  move <doc> --parent <父文档>          移动文档 (同 mv)
  remove <doc>                         删除文档 (同 rm)

数据库 (属性视图, 适配 3.8.0; 别名 av):
  db list [--json|--markdown]         列出全部数据库 (名称+avID)
  db keys <avID> [--json|--markdown]  列字段
  db rows <avID> [--limit N] [-H] [--json|--markdown]  列行数据 (走 render)
  db get <avID> --row <rowID> [--json|--markdown]  单行详情
  db add <avID> --values '<JSON>' [--content <标题>] [--block <doc-id>] [--json|--markdown]  加行
  db update <avID> --row <rowID> --values '<JSON>' [--json|--markdown]  改行 (写后验证)
  db remove <avID> --row <rowID> [--json|--markdown]  删行
  db verify <avID> [--json|--markdown] 逐行打印实际值 (验证权威入口)
  db export <avID>                   导出全量 JSON (备份)

底层:
  raw <args...>                        透传 SiYuan-Kernel (自带 -w, 默认 table; --markdown 原样无转换)
  raw-help <sub...>                    查底层命令帮助 (例: raw-help block insert)

其他:
  help [命令]                          帮助; notebooks/list/read/get/outline/search 为旧名别名

文档引用 <doc>: id | 标题 | 路径 (Linux 直觉, 全部命令一致):
  路径必须真实存在, 不存在即报错; 模糊用显式通配 * (任意层级) 和 ? (单字符)
  完整路径 /工作/日志/2026/AI伴学 (带不带前导 / 均可) → hpath /日志/2026/AI伴学
  通配 /*/AI伴学 (glob 多命中为正常结果, 列出全部; 单目标命令列候选报歧义)
  无 / 的引用按标题匹配 (精确同名优先, 多匹配列候选)
  find/grep/which -v 输出统一为完整路径, 可直接喂回
环境变量: SIYUAN_KERNEL / SIYUAN_WORKSPACE / SIYUAN_FORMAT(text|json) /
          SIYUAN_TIMEOUT(默认60) / SIYUAN_DEFAULT_NOTEBOOK / SIYUAN_API_HOST / SIYUAN_API_PORT
EOF
}

# 单命令帮助
sy_usage() {
  case "$1" in
    ls)       cat <<'EOF'
用法: siyuan ls [引用] [-l] [--json|--markdown]
  无参: 列笔记本 (设 SIYUAN_DEFAULT_NOTEBOOK 时列该库根目录文档)
  引用: 笔记本名/id (列库根) | 路径 (列目录, 必须真实存在, 不存在即报错)
  ls 工作                   列笔记本「工作」根目录
  ls /工作/日志/2026/AI伴学   列目录
  ls /*/AI伴学              通配: * 匹配任意层级 (含零层), 多命中列出文档本身
  ls 2026xxxx-abc           按文档 id 列其子文档
  标题引用多匹配列候选并报错; 双参 ls <笔记本> /路径 仍兼容
  -l  详情; --json 稳定字段; --markdown 表格 (如 siyuan ls --markdown > 目录.md)
EOF
;;
    tree)     cat <<'EOF'
用法: siyuan tree <doc> [-l] [--json|--markdown]
  标题树/大纲 (对应 outline get); 文本按标题层级缩进, -l 附块 id;
  --markdown 嵌套无序列表
EOF
;;
    cat)      cat <<'EOF'
用法: siyuan cat <doc> [--json|--markdown]
  读文档 markdown (export md, 最准); 文本=纯 markdown 可直接管道消费;
  --markdown 与原样相同 (本就是 md)
EOF
;;
    head|tail) cat <<'EOF'
用法: siyuan head|tail <doc> [-n N] [--json|--markdown]
  读文档开头/末尾 N 行 (默认 10; 内部 cat 截断, 不新增内核调用);
  --markdown 用 fenced code block 标记片段
EOF
;;
    find)     cat <<'EOF'
用法: siyuan find <关键词> [--notebook <nb>] [-l N] [--json|--markdown]
  跨库搜文档标题 (document search); 与 grep 区分: find 找文档, grep 找内容
  输出: doc_id<TAB>hPath<TAB>notebook_id; --markdown 链接式列表
EOF
;;
    grep)     cat <<'EOF'
用法: siyuan grep <pattern> [-v] [-i] [-l] [-m 0-3] [--notebook <nb>] [-s N] [--json|--markdown]
  双模式:
    stdin 非终端: 按行过滤上游输出 (真 grep), 如 siyuan ls 工作 | siyuan grep 调课
    stdin 终端:   内容全文检索 (kernel search; -m 0=关键词 1=query-syntax 2=sql 3=regex)
  内容模式输出: doc_id<TAB>hPath<TAB>内容; -l 只列 doc_id; 无匹配退出 1;
  --markdown 按文档分组列表 (文档链接 + 内容片段)
EOF
;;
    which)    cat <<'EOF'
用法: siyuan which <doc-id|标题|/路径> [-v] [--json|--markdown]
  定位文档 → 输出唯一 doc id (可组合: cat $(siyuan which 标题))
  -v 附 hPath/notebook; 多匹配列出候选并退出 1 (用 /完整路径 消歧);
  --markdown 键值列表 (文档 ID/路径/笔记本)
EOF
;;
    stat)     cat <<'EOF'
用法: siyuan stat <doc> [--json|--markdown]
  文档元信息 (document get); 文本 key: value, --json 原始对象, --markdown 键值表
EOF
;;
    sql)      cat <<'EOF'
用法: siyuan sql "<语句>" [-l N] [-H] [--json|--markdown]
  SQL 查询 (透传内核, 默认 limit 100); 文本=TSV 行 (无表头可组合, -H 加表头);
  --markdown 表格 (含表头分隔行), 如 siyuan sql "SELECT id,hpath FROM blocks LIMIT 5" --markdown
EOF
;;
    touch)    cat <<'EOF'
用法: siyuan touch --notebook <nb> --title <t> [--parent <pid> | --path <hpath>] [--data <md>|--file <md>|stdin]
  新建文档 (默认笔记本根目录); 内容可选 (空文档 = 空文件语义)
  --parent <pid>  建到该父文档下 (父文档 id/标题/路径)
  --path <hpath>  按人类可读路径建 (如 /供应链); HTTP 不可用时需该路径已存在
  内部: createDocWithMd 三步语义 (建/移/删中间块), HTTP 不可用自动回退 CLI
  输出: 新文档 id
EOF
;;
    edit)     cat <<'EOF'
用法: siyuan edit <doc> (--append|--prepend|--update <block-id>|--replace) <text> [--file <f>|stdin]
  统一编辑入口, 内部路由:
    --append <text>      追加到文档末尾
    --prepend <text>     插入到文档开头
    --update <block-id> <text>  改指定块内容 (块 id 用 'siyuan children <doc>' 定位)
    --replace <text>     整篇替换 (删旧写新, 保留标题)
  文本可省略改从 --file / 管道 stdin 传入 (中文/引号内容推荐)
  输出: 目标 id (append/prepend/replace = 文档 id, update = 块 id)
EOF
;;
    mv)       cat <<'EOF'
用法: siyuan mv <doc> --to <parent-id> [--notebook <nb>] | siyuan mv <doc> --notebook <nb>
  移动文档 (同/跨笔记本均支持)
  --to <parent-id>   移到该文档下 (自动取父文档所在笔记本)
  --notebook <nb>    显式指定目标笔记本 (无 --to 时移到该库根目录)
  输出: 被移动的文档 id
EOF
;;
    cp)       cat <<'EOF'
用法: siyuan cp <doc> [--to <parent-id>]
  复制文档 (duplicate, 同目录生成 "标题 (Duplicated ...)" 副本)
  --to <parent-id>   复制后移到该文档下 (可跨笔记本)
  输出: 新副本的文档 id
EOF
;;
    rm)       cat <<'EOF'
用法: siyuan rm <doc-id|标题|/路径>
  删除文档 (引用可为 id/标题/完整路径); 输出被删除的文档 id
EOF
;;
    diff)     cat <<'EOF'
用法: siyuan diff <docA> <docB> [diff 参数...]
  对比两文档 markdown (内部 cat + diff); 默认 -u 统一 diff 格式
  额外参数透传给系统 diff (如 -w 忽略空白, -U 5 上下文行数)
  退出码同 diff: 0=相同 1=有差异 2=错误
EOF
;;
    rename)   cat <<'EOF'
用法: siyuan rename <doc-id|标题|/路径> <新标题>
  重命名文档: IAL title (文档名) + H1 子块文本同步, 避免 title/H1 不一致
  输出: 文档 id
EOF
;;
    children) cat <<'EOF'
用法: siyuan children <block|doc> [--json|--markdown]
  子块列表 (编辑前定位): id<TAB>type<TAB>内容; 文档引用自动定位到其根块
  (如 siyuan children 调课 = 列该文档全部子块)
EOF
;;
    backlinks) cat <<'EOF'
用法: siyuan backlinks <block|doc> [--keyword <kw>] [--json|--markdown]
  反链查询; 文档引用自动定位到其根块
EOF
;;
    write) cat <<'EOF'
用法: siyuan write --notebook <nb> --title <t> [--parent <父文档>|--path <hpath>] [--data <md>|--file <f>|stdin]
  建文档 (同 touch, 推荐用 touch); --parent 引用支持 id/标题/路径; 输出新文档 id
EOF
;;
    append) cat <<'EOF'
用法: siyuan append <doc> [--data <md>|--file <f>|stdin] [--json|--markdown]
  追加到文档末尾 (同 edit --append); 引用支持 id/标题/路径; 输出文档 id
EOF
;;
    insert-block) cat <<'EOF'
用法: siyuan insert-block [--previous <块>|--parent <块|doc>] [--data <md>|--file <f>|stdin]
  插入块; --previous 为兄弟锚点 (自动取父), --parent 为父块/文档; 输出父块 id
EOF
;;
    update-block) cat <<'EOF'
用法: siyuan update-block <block-id> [--data <md>|--file <f>] [--json|--markdown]
  替换块内容 (同 edit --update); 输出块 id
EOF
;;
    delete-block) cat <<'EOF'
用法: siyuan delete-block <block-id> [--json|--markdown]
  删除块 (同 edit 无对应模式, 用 children 定位块 id); 输出块 id
EOF
;;
    replace-doc) cat <<'EOF'
用法: siyuan replace-doc <doc> [--data <md>|--file <f>|stdin] [--json|--markdown]
  替换整篇文档 (删旧写新, 保留标题; 同 edit --replace); 引用支持 id/标题/路径; 输出文档 id
EOF
;;
    move) cat <<'EOF'
用法: siyuan move <doc> --parent <父文档> [--json|--markdown]
  移动文档 (同 mv); 引用支持 id/标题/路径; 输出文档 id
EOF
;;
    remove) cat <<'EOF'
用法: siyuan remove <doc> [--json|--markdown]
  删除文档 (同 rm); 引用支持 id/标题/路径; 输出文档 id
EOF
;;
    db|av|raw|raw-help)
      usage >&2
      if [[ -n "${1:-}" && "$1" =~ ^(db|av) ]]; then
        local sub="${1#db }"
        [[ "$1" == av* ]] && sub="${1#av }"
        av_usage "$sub"
      else
        usage >&2
      fi
      ;;
    *) usage >&2;;
  esac
}

# ---------------------------------------------------------------------------
# 主入口
# ---------------------------------------------------------------------------
cmd_help() {
  if [[ -n "${1:-}" ]]; then
    sy_usage "$1"
  else
    usage
  fi
}

main() {
  if [[ $# -eq 0 ]]; then
    usage
    return 0
  fi
  local cmd="$1"; shift
  case "$cmd" in
    -h|--help|help) cmd_help "$@"; return 0;;
  esac
  SY_CMD_NAME="$cmd"
  local rc=0
  sy_dispatch "$cmd" "$@" || rc=$?
  if [[ $rc -eq 255 ]]; then
    echo "siyuan: 未知命令: $cmd" >&2
    echo "  建议: 运行 'siyuan help' 查看用法, 或 'siyuan raw --help' 看底层命令全集" >&2
    return 2
  fi
  return "$rc"
}
main "$@"
